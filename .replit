modules = ["python-3.12", "nodejs-24", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["libGL", "libGLU", "libxcrypt", "pkg-config", "xorg.libxcb", "xsimd"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "MedVision API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "MedVision Web"

[[workflows.workflow]]
name = "MedVision API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && uv run --locked --no-sync uvicorn medvision.main:app --host 0.0.0.0 --port 8000"
waitForPort = 8000

[[workflows.workflow]]
name = "MedVision Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev -- --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 80

[postMerge]
path = "backend/scripts/post-merge.sh"
timeoutMs = 180000
